# .env.example
NODE_ENV=development
PORT=3003

# Isolated Redis Connection (Handles High-Concurrency Locks/Counters)
REDIS_URL=redis://localhost:6379

# Isolated PostgreSQL Database Credentials (Durable Storage)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres_user
DB_PASSWORD=postgres_password
DB_NAME=flashscale_inventory